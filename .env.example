# URL pública deste ambiente, sem barra final.
# Desenvolvimento local seguro:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set true only with the real public HTTPS domain above.
NEXT_PUBLIC_SITE_INDEXABLE=false

