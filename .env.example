# URL pública deste ambiente, sem barra final.
# Desenvolvimento local seguro:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default: local static content, integrations and indexing disabled.
SITE_CMS_ENABLED=false
SITE_ADMIN_ENABLED=false
# Set true only with the real public HTTPS domain above.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Supabase Auth: apenas URL e chave publicável podem chegar ao navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Lista de administradores autorizados, separada por vírgula (somente servidor).
ADMIN_EMAILS=

# Instagram (opcional). Nunca use credenciais de produção no desenvolvimento.
IG_ACCESS_TOKEN=
IG_USER_ID=

# Sanity: identificadores públicos podem chegar ao navegador; tokens e secrets nunca.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-01
SANITY_PROJECT_ID=
SANITY_DATASET=development
SANITY_API_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_API_READ_TOKEN=
SANITY_PREVIEW_SECRET=
SANITY_REVALIDATE_SECRET=
