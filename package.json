{
  "name": "creator-site-template",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "sanity:dev": "sanity dev",
    "sanity:build": "sanity build",
    "migrate:sanity": "node --experimental-strip-types scripts/migrate-to-sanity.ts",
    "rollback:sanity": "node --experimental-strip-types scripts/rollback-sanity.ts",
    "optimize:images": "node scripts/optimize-images.mjs",
    "sync:instagram": "node scripts/sync-instagram.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@portabletext/react": "^7.0.1",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.9.1",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "next": "16.3.5",
    "next-sanity": "^13.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "sharp": "0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "postcss": "8.5.24",
    "sharp": "0.35.4",
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.8.0"
    },
    "@module-federation/dts-plugin": {
      "adm-zip": "0.6.1"
    },
    "typeid-js@1.2.0": {
      "uuid": "11.1.1"
    }
  }
}
